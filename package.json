{
  "name": "hotelaria-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "22.23.2",
    "pnpm": "9.12.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "dompurify@<=3.4.12": "3.4.13",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.26",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "sharp@<0.35.0": "0.35.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm run doctor",
    "doctor": "node scripts/doctor.mjs",
    "deps:outdated": "pnpm outdated -r",
    "deps:outdated:json": "pnpm outdated -r --format json",
    "security:audit": "pnpm audit --audit-level high",
    "check": "pnpm api:openapi:check && pnpm lint && pnpm typecheck && pnpm build",
    "check:full": "node scripts/check-full.mjs",
    "check:ci": "pnpm security:audit && pnpm check:full",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:scripts && turbo run lint",
    "lint:scripts": "node --check scripts/doctor.mjs && node --check scripts/check-full.mjs && node --check scripts/database.mjs && node --check scripts/coverage.mjs",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:coverage": "node scripts/coverage.mjs",
    "coverage:report": "node scripts/coverage.mjs --report-only",
    "test:watch": "turbo run test:watch --parallel",
    "test:e2e": "turbo run test:e2e --filter=@hotel/pms",
    "api:openapi": "pnpm --filter @hotel/backend-service openapi:generate",
    "api:openapi:check": "pnpm --filter @hotel/backend-service openapi:check",
    "db:start": "node scripts/database.mjs start",
    "db:status": "node scripts/database.mjs status",
    "db:reset": "node scripts/database.mjs reset",
    "db:stop": "node scripts/database.mjs stop",
    "db:types": "node scripts/database.mjs types",
    "db:types:check": "node scripts/database.mjs types-check",
    "test:db": "node scripts/database.mjs test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.21",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.21",
    "msw": "^2.15.0",
    "supabase": "^2.115.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
