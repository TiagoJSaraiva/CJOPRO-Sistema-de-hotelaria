{
  "name": "hotelaria-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "22.23.2",
    "pnpm": "9.12.3"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm run doctor",
    "doctor": "node scripts/doctor.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "check:full": "node scripts/check-full.mjs",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:scripts && turbo run lint",
    "lint:scripts": "node --check scripts/doctor.mjs && node --check scripts/check-full.mjs",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch --parallel",
    "test:e2e": "turbo run test:e2e --filter=@hotel/pms"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.17",
    "msw": "^2.13.2",
    "supabase": "^2.115.0",
    "turbo": "^2.0.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  }
}
