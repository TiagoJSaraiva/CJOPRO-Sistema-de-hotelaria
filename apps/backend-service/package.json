{
  "name": "@hotel/backend-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "debug:permissions": "tsx src/scripts/getPermissions.ts",
    "openapi:generate": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts __tests__ --max-warnings=0",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run __tests__/unit --passWithNoTests",
    "test:integration": "vitest run __tests__/integration --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests --reporter=default --reporter=junit --outputFile.junit=coverage/junit.xml",
    "test:watch": "vitest --watch --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@hotel/shared": "workspace:^",
    "@supabase/supabase-js": "^2.112.4",
    "argon2": "^0.45.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.1",
    "typebox": "1.3.19"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/node": "^22.20.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
