{
  "name": "@hotel/pms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src __tests__ --max-warnings=0",
    "clean": "rimraf .next",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run __tests__/unit --passWithNoTests",
    "test:integration": "vitest run __tests__/integration --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests --reporter=default --reporter=junit --outputFile.junit=coverage/junit.xml",
    "test:watch": "vitest --watch --passWithNoTests",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual:update": "playwright test --grep @visual --update-snapshots=changed"
  },
  "dependencies": {
    "@hotel/shared": "workspace:*",
    "countries-and-timezones": "^3.10.0",
    "countries-list": "^3.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "15.5.21",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
